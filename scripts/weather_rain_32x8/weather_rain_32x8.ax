# @name Weather Rain
# @desc Weather with temperature, humidity and rain/snow, each with a 15-hour forecast, and moon phase
# @author Hank_the_Tank (original), TJuTZu / Claude (modifications)
# @version 4.1
# Based on "Weather Script" 3.7 by .hank_the_tank (https://awtrix.de/script/fGEhP0cZZd6E)
# Modified: https://github.com/TJuTZu/AwtrixNG - weather data: Open-Meteo
# @config lat number "Latitude" default=52.52 min=-90 max=90 step=0.0001
# @config lon number "Longitude" default=13.40 min=-180 max=180 step=0.0001
# @config unit select "Temperature unit" default=C options=C,F
# @config every number "Refresh" default=15 min=15 max=60 unit=min
# @config showtemp bool "Show temperature" default=true
# @config showhum bool "Show humidity" default=true
# @config showrain bool "Show rain / snow" default=true
# @config hold number "Swap after" default=3 min=1 max=10 unit=s help="How long each value stays before sliding to the next"

class Weather
  var st, hs, rs, ss, rows, lab, col, cur, items, traw
  var wic, mic, mday, ticks, age, busy, period, hold, t0

  def init()
    self.st = [-12, 0xD977DF, -6, 0x9545BC, -1, 0x4B379C, 0, 0xFEC4FF,
               4, 0x31B8DB, 10, 0x31DB8B, 15, 0x6ED228, 21, 0xFFFF28,
               27, 0xF87E27, 32, 0xCF3927, 38, 0xA12527]
    self.hs = [20, 0xF87E27, 35, 0xFFFF28, 50, 0x6ED228, 65, 0x31DB8B,
               80, 0x31B8DB, 100, 0x2A4BD6]
    self.rs = [0, 0x23375F, 0.2, 0x5CC8FF, 1, 0x2F7BFF, 3, 0x6A2BE2,
               6, 0xE0309F]
    self.ss = [0, 0x3A3F4E, 0.2, 0x8C9BC0, 1, 0xC8D4F0, 3, 0xFFFFFF]
    self.rows = [[], [], []]
    self.cur = 0
    self.period = store.get("every") * 60
    self.traw = store.get("temp")
    var tl = nil
    if self.traw != nil tl = self.label_for(self.traw) end
    self.lab = [tl, store.get("hl", "-"), "-"]
    self.col = [store.get("col", 0x666666), store.get("hcol", 0x666666), 0x666666]
    self.wic = store.get("icon", "")
    self.mic = ""
    self.mday = -1
    self.ticks = 0
    self.age = 9999
    self.busy = false
    self.hold = int(store.get("hold") * 1000)
    self.t0 = 0
    self.items = []
    if store.get("showtemp") self.items.push(0) end
    if store.get("showhum") self.items.push(1) end
    if store.get("showrain") self.items.push(2) end
    if size(self.items) == 0 self.items.push(0) end
  end

  def label_for(t)
    var u = store.get("unit")
    var v = u == "F" ? t * 1.8 + 32 : t
    return str(int(v + (v >= 0 ? 0.5 : -0.5))) + (u == "F" ? "F" : "°")
  end

  def ramp(s, v)
    var n = size(s)
    if v <= s[0] return s[1] end
    var j = 0
    while j < n - 2 && v >= s[j + 2]
      j += 2
    end
    if j >= n - 2 return s[n - 1] end
    var a = s[j + 1]
    var b = s[j + 3]
    var f = (v - s[j]) * 1.0 / (s[j + 2] - s[j])
    return rgb(int(a / 65536 % 256 + (b / 65536 % 256 - a / 65536 % 256) * f),
               int(a / 256 % 256 + (b / 256 % 256 - a / 256 % 256) * f),
               int(a % 256 + (b % 256 - a % 256) * f))
  end

  def colors(txt, stops, stxt)
    var vals = re.matchall("[-0-9.]+", txt)
    var sv = []
    if size(stxt) > 0 sv = re.matchall("[-0-9.]+", stxt) end
    var n = size(vals)
    if n > 15 n = 15 end
    var out = []
    var i = 0
    while i < n
      var v = num(vals[i])
      if v == nil v = 0 end
      var sn = 0
      if i < size(sv) sn = num(sv[i]) end
      if sn == nil sn = 0 end
      out.push(self.ramp(sn > 0 && sn * 10.0 / 7 * 2 >= v ? self.ss : stops, v))
      i += 1
    end
    return out
  end

  def on_body(w, status)
    self.busy = false
    if w == nil
      self.ticks = 60
      return
    end
    var m = re.search("_2m\":([-0-9.]+)", w)
    var c = re.search("code\":(\\d+)", w)
    var h = re.search("_2m\":\\[([^\\]]*)", w)
    if m == nil || c == nil || h == nil || num(m[1]) == nil
      self.ticks = 60
      return
    end
    var t = num(m[1])
    self.traw = t
    self.col[0] = self.ramp(self.st, t)
    self.lab[0] = self.label_for(t)
    self.rows[0] = self.colors(h[1], self.st, "")

    var hm = re.search("humidity_2m\":([0-9.]+)", w)
    var hh = re.search("humidity_2m\":\\[([^\\]]*)", w)
    if hm != nil && num(hm[1]) != nil
      var hv = num(hm[1])
      var hs = str(int(hv + 0.5))
      self.lab[1] = text_ink_width(hs + "%") > 14 ? hs : hs + "%"
      self.col[1] = self.ramp(self.hs, hv)
      store.set("hl", self.lab[1])
      store.set("hcol", self.col[1])
    end
    if hh != nil self.rows[1] = self.colors(hh[1], self.hs, "") end

    var pc = re.search("precipitation\":([0-9.]+)", w)
    var sc = re.search("snowfall\":([0-9.]+)", w)
    var pa = re.search("precipitation\":\\[([^\\]]*)", w)
    var sa = re.search("snowfall\":\\[([^\\]]*)", w)
    if pc != nil && num(pc[1]) != nil
      var q = num(pc[1])
      var r = int(q * 10 + 0.5)
      var s = str(int(r / 10)) + "." + str(r % 10)
      if text_ink_width(s) > 14 s = str(int(q + 0.5)) end
      self.lab[2] = s
      self.col[2] = self.colors(pc[1], self.rs, sc == nil ? "" : sc[1])[0]
    end
    if pa != nil self.rows[2] = self.colors(pa[1], self.rs, sa == nil ? "" : sa[1]) end

    var k = int(num(c[1]))
    var ic = "36637"
    if k == 0     ic = "53386"
    elif k <= 2   ic = "2286"
    elif k == 3   ic = "53384"
    elif k <= 48  ic = "17055"
    elif k <= 67  ic = "2720"
    elif k <= 77  ic = "2289"
    elif k <= 82  ic = "49300"
    elif k <= 86  ic = "2289"
    elif k >= 95  ic = "29839"
    end
    self.wic = ic
    self.age = 0
    store.set("temp", t)
    store.set("col", self.col[0])
    store.set("icon", ic)
  end

  def loop()
    var d = day()
    if d != self.mday
      self.mday = d
      var mo = month()
      var a = int((14 - mo) / 12)
      var yy = year() + 4800 - a
      var mm = mo + 12 * a - 3
      var f = (d + int((153 * mm + 2) / 5) + 365 * yy + int(yy / 4) -
               int(yy / 100) + int(yy / 400) - 2483595) / 29.53058867
      f -= int(f)
      var ic = "2317"
      if f < 0.03 || f >= 0.97  ic = "2318"
      elif f < 0.22             ic = "2321"
      elif f < 0.28             ic = "2320"
      elif f < 0.48             ic = "2319"
      elif f < 0.52             ic = "2314"
      elif f < 0.72             ic = "2315"
      elif f < 0.78             ic = "2316"
      end
      self.mic = ic
    end
    self.age += 1
    if self.ticks <= 0 && !self.busy
      self.ticks = self.period
      self.busy = true
      http.get("http://api.open-meteo.com/v1/forecast" +
               "?latitude=" + str(store.get("lat")) +
               "&longitude=" + str(store.get("lon")) +
               "&current=temperature_2m,relative_humidity_2m,precipitation,snowfall,weather_code" +
               "&hourly=temperature_2m,relative_humidity_2m,precipitation,snowfall" +
               "&forecast_hours=15&timeformat=unixtime&timezone=auto",
               / b, st -> self.on_body(b, st),
               {'find': "\"current\":", 'keep': 1100})
    end
    self.ticks -= 1
  end

  def on_show()
    self.t0 = now_ms()
  end

  def draw()
    clear()
    if self.lab[0] == nil
      text(6, 6, "...", 0x666666)
      return
    end
    if !icon(self.wic, 0, 0)
      circle_fill(4, 4, 3, 0xFFCC00)
    end
    var its = self.items
    var n = size(its)
    var a = its[0]
    var b = a
    var off = 0
    var sl = false
    self.cur = a
    if n > 1
      var slide = 400
      var per = self.hold + slide
      var t = now_ms() - self.t0
      var p = t % per
      var idx = int(t / per) % n
      a = its[idx]
      if p >= self.hold
        sl = true
        b = its[(idx + 1) % n]
        off = (p - self.hold) * 8 / slide
      end
      self.cur = sl ? b : a
    end
    var s = self.lab[a]
    text(9 + int((14 - text_ink_width(s)) / 2), 6 - off, s, self.col[a])
    if sl
      s = self.lab[b]
      text(9 + int((14 - text_ink_width(s)) / 2), 14 - off, s, self.col[b])
    end
    if !icon(self.mic, 23, 0)
      circle_fill(27, 4, 3, 0xAAAAAA)
    end
    var row = self.rows[self.cur]
    var i = 0
    var rn = size(row)
    while i < rn
      pixel(8 + i, 7, row[i])
      i += 1
    end
    if self.age > self.period + 300
      pixel(width() - 1, height() - 1, 0xFF0000)
    end
  end

  def on_button(btn)
    if btn == "select" self.ticks = 0 end
  end
end

return Weather()
